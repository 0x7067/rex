{
  "name": "@0x7067/rex",
  "version": "0.1.0-alpha.2",
  "packageManager": "bun@1.4.4",
  "description": "rex: resource-first persistent knowledge CLI",
  "type": "module",
  "bin": {
    "rex": "./dist/bin/rex.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/rex.ts",
    "bench:indexing": "tsx scripts/bench-indexing.ts",
    "preflight:macos": "bash scripts/preflight-macos.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "tsc",
    "test:rag": "vitest run test/rag",
    "eval:rag": "tsx scripts/eval-rag.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x7067/rex.git"
  },
  "homepage": "https://github.com/0x7067/rex",
  "bugs": {
    "url": "https://github.com/0x7067/rex/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "keywords": [
    "rex",
    "cli",
    "knowledge",
    "retrieval",
    "llm",
    "rag",
    "claude",
    "ollama"
  ],
  "files": [
    "dist/bin/**",
    "dist/src/**",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@lancedb/lancedb": "^0.41.0",
    "apache-arrow": "^21.2.0",
    "commander": "^15.0.0",
    "execa": "^10.2.1",
    "ignore": "^7.0.14",
    "minimatch": "^11.0.3",
    "node-llama-cpp": "^3.22.2",
    "ora": "^9.4.1",
    "simple-git": "^4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "simple-git": "4.0.2",
    "sharp": "0.35.5"
  }
}
